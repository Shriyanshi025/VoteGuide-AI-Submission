# VoteGuide AI - Environment Configuration Example

# Google Gemini API Key (Required for AI features)
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key (Required for Booth Finder)
# Enable Places API and Geocoding API at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Port
PORT=3000
